## Authorize: admin Cognito group only (mirrors the @model write rules).
#set( $groups = $util.defaultIfNull($ctx.identity.claims.get("cognito:groups"), []) )
#if( !$groups.contains("admin") )
  $util.unauthorized()
#end

## Atomic DynamoDB increment of a single GameScore cell. ADD treats a missing
## attribute as 0. attribute_exists(id) ensures we only update an existing row,
## never create one.
{
  "version": "2018-05-29",
  "operation": "UpdateItem",
  "key": {
    "id": $util.dynamodb.toDynamoDBJson($ctx.args.id)
  },
  "update": {
    "expression": "ADD #score :delta",
    "expressionNames": {
      "#score": "score"
    },
    "expressionValues": {
      ":delta": $util.dynamodb.toDynamoDBJson($ctx.args.delta)
    }
  },
  "condition": {
    "expression": "attribute_exists(id)"
  }
}
